// ─────────────────────────────────────────────────────────────────────────────
// Plumbing website — database schema (PostgreSQL)
// Conventions: cuid ids, createdAt/updatedAt on every mutable table, soft delete
// (deletedAt) where "restore" is a requirement, SEO stored once in SeoMeta.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

/// Lead pipeline. History of changes is kept in LeadEvent.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  BOOKED
  COMPLETED
  INVALID
  SPAM
  CLOSED
}

enum LeadSource {
  SERVICE_REQUEST_FORM
  CONTACT_FORM
  PHONE
  MANUAL
}

enum PreferredTime {
  ASAP
  MORNING
  AFTERNOON
  EVENING
}

enum PhoneType {
  MAIN
  EMERGENCY
  TRACKING
  SMS
}

enum NavLocation {
  HEADER
  FOOTER_QUICK_LINKS
  FOOTER_LEGAL
}

enum KeywordIntent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
}

enum KeywordPriority {
  HIGH
  MEDIUM
  LOW
}

enum KeywordStatus {
  UNASSIGNED
  ASSIGNED
  IGNORED
}

enum KeywordRole {
  PRIMARY
  SECONDARY
}

enum CtaType {
  CALL
  REQUEST_SERVICE
  SMS
  EMAIL
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  UNKNOWN
}

// ───────────── Identity, roles & permissions ─────────────

/// Admin users. Website visitors never get accounts; every User is a staff/admin user.
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  passwordHash     String
  roleId           String
  role             Role      @relation(fields: [roleId], references: [id])
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  /// TOTP 2FA. Secret is encrypted at rest (AES-256-GCM, APP_ENCRYPTION_KEY).
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions       Session[]
  resetTokens    PasswordResetToken[]
  auditLogs      AuditLog[]
  assignedLeads  Lead[]               @relation("LeadAssignee")
  leadNotes      LeadNote[]
  leadEvents     LeadEvent[]
  author         Author?
  uploadedMedia  Media[]
  keywordImports KeywordImport[]

  @@index([roleId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  /// System roles (Owner) cannot be deleted or stripped of permissions.
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "leads:write"
  group       String
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Server-side sessions. Only a SHA-256 hash of the cookie token is stored.
model Session {
  id               String   @id @default(cuid())
  tokenHash        String   @unique
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// true between password check and TOTP verification
  twoFactorPending Boolean  @default(false)
  expiresAt        DateTime
  lastSeenAt       DateTime @default(now())
  ip               String?
  userAgent        String?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // create | update | delete | restore | publish | login | ...
  entity    String
  entityId  String?
  summary   String?
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
}

// ───────────── Media & SEO ─────────────

model Media {
  id           String    @id @default(cuid())
  /// Public URL path of the optimized original, e.g. /media/2026/11/abc.webp
  url          String
  storageKey   String    @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  alt          String    @default("")
  title        String?
  /// Generated responsive versions: [{ width, height, url, format }]
  variants     Json      @default("[]")
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  serviceImages   Service[]      @relation("ServiceImage")
  postImages      Post[]         @relation("PostImage")
  seoOgImages     SeoMeta[]
  authorAvatars   Author[]
  logoFor         BusinessInfo[] @relation("Logo")
  faviconFor      BusinessInfo[] @relation("Favicon")

  @@index([createdAt])
}

/// One row per SEO-able entity (service, service area, post, page, blog category).
model SeoMeta {
  id              String   @id @default(cuid())
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  /// e.g. "index,follow" | "noindex,follow"
  robots          String   @default("index,follow")
  ogTitle         String?
  ogDescription   String?
  ogImageId       String?
  ogImage         Media?   @relation(fields: [ogImageId], references: [id], onDelete: SetNull)
  /// Extra JSON-LD merged into the page schema (validated as an object)
  schemaJson      Json?
  updatedAt       DateTime @updatedAt

  service      Service?
  serviceArea  ServiceArea?
  post         Post?
  page         Page?
  blogCategory BlogCategory?
}

// ───────────── Services ─────────────

model ServiceCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]
}

model Service {
  id               String          @id @default(cuid())
  slug             String          @unique
  name             String
  categoryId       String
  category         ServiceCategory @relation(fields: [categoryId], references: [id])
  icon             String          @default("wrench")
  shortDescription String
  h1               String
  /// Long description: string[] of paragraphs
  intro            Json            @default("[]")
  signsTitle       String          @default("")
  signs            Json            @default("[]")
  featuresTitle    String          @default("")
  /// [{ title, description }]
  features         Json            @default("[]")
  ctaHeading       String?
  ctaText          String?
  /// Optional canonical path override, e.g. "/emergency-plumbing"
  pathOverride     String?
  featuredImageId  String?
  featuredImage    Media?          @relation("ServiceImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  isFeatured       Boolean         @default(false)
  isEmergency      Boolean         @default(false)
  status           ContentStatus   @default(DRAFT)
  sortOrder        Int             @default(0)
  seoId            String          @unique
  seo              SeoMeta         @relation(fields: [seoId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  faqs          Faq[]
  areas         ServiceAreaService[]
  relatedTo     ServiceRelation[]    @relation("ServiceRelationFrom")
  relatedFrom   ServiceRelation[]    @relation("ServiceRelationTo")
  posts         PostService[]
  leads         Lead[]
  keywords      Keyword[]
  testimonials  Testimonial[]

  @@index([status, sortOrder])
  @@index([categoryId])
}

model ServiceRelation {
  serviceId        String
  relatedServiceId String
  sortOrder        Int     @default(0)
  service          Service @relation("ServiceRelationFrom", fields: [serviceId], references: [id], onDelete: Cascade)
  related          Service @relation("ServiceRelationTo", fields: [relatedServiceId], references: [id], onDelete: Cascade)

  @@id([serviceId, relatedServiceId])
}

// ───────────── Locations ─────────────

model State {
  id        String   @id @default(cuid())
  code      String   @unique // "TX"
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
}

model City {
  id          String       @id @default(cuid())
  name        String
  slug        String
  stateId     String
  state       State        @relation(fields: [stateId], references: [id])
  lat         Float?
  lng         Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  serviceArea ServiceArea?

  @@unique([stateId, slug])
}

/// A published location landing page. Publishing requires genuinely local content (enforced in the API).
model ServiceArea {
  id                  String        @id @default(cuid())
  slug                String        @unique // "houston-tx"
  cityId              String        @unique
  city                City          @relation(fields: [cityId], references: [id])
  description         String        @default("")
  /// string[] paragraphs
  intro               Json          @default("[]")
  /// [{ title, description }]
  localConsiderations Json          @default("[]")
  nearbyAreas         String[]
  zipCodes            String[]
  status              ContentStatus @default(DRAFT)
  sortOrder           Int           @default(0)
  seoId               String        @unique
  seo                 SeoMeta       @relation(fields: [seoId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  services ServiceAreaService[]
  faqs     Faq[]
  keywords Keyword[]

  @@index([status, sortOrder])
}

model ServiceAreaService {
  serviceAreaId String
  serviceId     String
  /// Featured on the location page ("Popular services in X")
  isFeatured    Boolean     @default(false)
  sortOrder     Int         @default(0)
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([serviceAreaId, serviceId])
  @@index([serviceId])
}

// ───────────── Blog ─────────────

model Author {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  role      String   @default("")
  bio       String   @default("")
  avatarId  String?
  avatar    Media?   @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model BlogCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  sortOrder   Int      @default(0)
  seoId       String?  @unique
  seo         SeoMeta? @relation(fields: [seoId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
}

model Tag {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  posts     PostTag[]
}

model Post {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String        @default("")
  intro           String        @default("")
  /// ContentBlock[] — see docs/BACKEND.md "Content blocks"
  body            Json          @default("[]")
  categoryId      String
  category        BlogCategory  @relation(fields: [categoryId], references: [id])
  authorId        String
  author          Author        @relation(fields: [authorId], references: [id])
  status          ContentStatus @default(DRAFT)
  /// Live when status is PUBLISHED, or SCHEDULED with publishedAt <= now()
  publishedAt     DateTime?
  featuredImageId String?
  featuredImage   Media?        @relation("PostImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  isFeatured      Boolean       @default(false)
  isPopular       Boolean       @default(false)
  seoId           String        @unique
  seo             SeoMeta       @relation(fields: [seoId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  tags     PostTag[]
  faqs     Faq[]
  services PostService[]
  keywords Keyword[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([deletedAt])
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model PostService {
  postId    String
  serviceId String
  sortOrder Int     @default(0)
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([postId, serviceId])
  @@index([serviceId])
}

// ───────────── Pages, FAQs, testimonials ─────────────

model Page {
  id        String        @id @default(cuid())
  slug      String        @unique // "privacy-policy", "about"
  title     String
  intro     String        @default("")
  body      Json          @default("[]")
  status    ContentStatus @default(DRAFT)
  /// System pages (legal) can be edited but not deleted
  isSystem  Boolean       @default(false)
  seoId     String        @unique
  seo       SeoMeta       @relation(fields: [seoId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  faqs     Faq[]
  keywords Keyword[]
}

/// FAQs attach to exactly one owner (service, service area, post, page) or a named group ("home").
model Faq {
  id            String       @id @default(cuid())
  question      String
  answer        String
  sortOrder     Int          @default(0)
  isActive      Boolean      @default(true)
  group         String?
  serviceId     String?
  service       Service?     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceAreaId String?
  serviceArea   ServiceArea? @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  postId        String?
  post          Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  pageId        String?
  page          Page?        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([serviceId])
  @@index([serviceAreaId])
  @@index([postId])
  @@index([pageId])
  @@index([group])
}

/// Real customer reviews only. `isVerified` = staff confirmed the review is genuine.
model Testimonial {
  id         String    @id @default(cuid())
  authorName String
  location   String?
  rating     Int?
  body       String
  source     String? // "Google", "Yelp"
  sourceUrl  String?
  serviceId  String?
  service    Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  isVerified Boolean   @default(false)
  isPublished Boolean  @default(false)
  sortOrder  Int       @default(0)
  receivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isPublished, sortOrder])
}

// ───────────── Leads & tracking ─────────────

model Lead {
  id            String         @id @default(cuid())
  referenceId   String         @unique
  name          String
  phone         String // 10 digits
  email         String?
  serviceId     String?
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceLabel  String? // free text when "Other / Not sure"
  zip           String
  preferredDate DateTime?      @db.Date
  preferredTime PreferredTime?
  message       String?
  source        LeadSource
  status        LeadStatus     @default(NEW)
  assignedToId  String?
  assignedTo    User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  // Attribution
  landingPage   String?
  sourcePath    String?
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  deviceType    DeviceType     @default(UNKNOWN)
  // Abuse protection
  ipHash        String?
  userAgent     String?
  /// Client-generated idempotency key — duplicate submits return the same lead
  submissionKey String?        @unique
  /// hash(phone|service|message) — used to collapse rapid duplicates
  dedupeHash    String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  notes          LeadNote[]
  events         LeadEvent[]
  contactMessage ContactMessage?

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([phone])
  @@index([dedupeHash, createdAt])
  @@index([assignedToId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([leadId])
}

/// Lead status history / timeline.
model LeadEvent {
  id         String      @id @default(cuid())
  leadId     String
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       String // CREATED | STATUS_CHANGED | ASSIGNED | NOTE_ADDED
  fromStatus LeadStatus?
  toStatus   LeadStatus?
  detail     String?
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([leadId, createdAt])
}

/// Contact-page submissions. Each one also creates a Lead (source CONTACT_FORM).
model ContactMessage {
  id        String   @id @default(cuid())
  leadId    String   @unique
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

/// A visitor clicked a call/request CTA. This is NOT a completed call.
model CtaClickEvent {
  id          String     @id @default(cuid())
  type        CtaType
  /// data-cta label from the frontend (e.g. "call-mobile-bar")
  placement   String?
  target      String? // tel number / href clicked
  pagePath    String
  deviceType  DeviceType @default(UNKNOWN)
  referrer    String?
  landingPage String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  visitorId   String? // anonymous first-party id (random), no PII
  ipHash      String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  calls CallEvent[]

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([pagePath])
}

/// A call CONFIRMED by a call-tracking provider webhook (CallRail, CTM, Twilio...). Never created from clicks.
model CallEvent {
  id                  String         @id @default(cuid())
  provider            String
  providerCallId      String
  trackingNumber      String?
  callerNumberHash    String?
  status              String // answered | missed | voicemail
  durationSeconds     Int?
  startedAt           DateTime
  attributedClickId   String?
  attributedClick     CtaClickEvent? @relation(fields: [attributedClickId], references: [id], onDelete: SetNull)
  rawPayload          Json
  createdAt           DateTime       @default(now())

  @@unique([provider, providerCallId])
  @@index([startedAt])
}

// ───────────── Business settings ─────────────

/// Singleton (id = "default").
model BusinessInfo {
  id                  String   @id @default("default")
  businessName        String
  legalName           String
  tagline             String   @default("")
  shortDescription    String   @default("")
  email               String
  street              String
  city                String
  region              String
  postalCode          String
  country             String   @default("US")
  serviceAreaLabel    String
  licenseNumber       String?
  priceRange          String?
  emergencyAvailable  Boolean  @default(true)
  emergencyLabel      String   @default("24/7 Emergency Plumbing")
  emergencyShortLabel String   @default("24/7 Emergency")
  trustFootnote       String   @default("")
  logoId              String?
  logo                Media?   @relation("Logo", fields: [logoId], references: [id], onDelete: SetNull)
  faviconId           String?
  favicon             Media?   @relation("Favicon", fields: [faviconId], references: [id], onDelete: SetNull)
  updatedAt           DateTime @updatedAt
}

model PhoneNumber {
  id        String    @id @default(cuid())
  label     String
  display   String
  e164      String
  type      PhoneType @default(MAIN)
  /// The number used for every CALL NOW button
  isPrimary Boolean   @default(false)
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// One row per weekday (0 = Sunday).
model BusinessHours {
  id        String   @id @default(cuid())
  dayOfWeek Int      @unique
  isClosed  Boolean  @default(false)
  opensAt   String? // "07:00"
  closesAt  String? // "19:00"
  note      String? // shown instead of times, e.g. "Emergency calls only"
  updatedAt DateTime @updatedAt
}

model TrustBadge {
  id               String   @id @default(cuid())
  label            String
  description      String
  icon             String
  requiresFootnote Boolean  @default(false)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  label     String
  url       String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NavigationItem {
  id        String           @id @default(cuid())
  location  NavLocation
  label     String
  href      String
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)
  parentId  String?
  parent    NavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  NavigationItem[] @relation("NavTree")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([location, sortOrder])
}

/// Singleton (id = "default").
model FooterSettings {
  id               String   @id @default("default")
  description      String?
  showServices     Boolean  @default(true)
  servicesLimit    Int      @default(10)
  showServiceAreas Boolean  @default(true)
  showHours        Boolean  @default(true)
  copyrightText    String?
  updatedAt        DateTime @updatedAt
}

/// Key/value system configuration (robots, lead notifications, analytics ids...).
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Redirect {
  id          String   @id @default(cuid())
  source      String   @unique // "/old-path"
  destination String
  statusCode  Int      @default(301)
  isActive    Boolean  @default(true)
  hits        Int      @default(0)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ───────────── Keyword management ─────────────

/// One row per unique keyword. A keyword can target at most ONE page (prevents cannibalization by design).
model Keyword {
  id            String          @id @default(cuid())
  keyword       String
  /// lowercased, whitespace-collapsed — unique
  normalized    String          @unique
  monthlyVolume Int?
  difficulty    Float?
  cpc           Float?
  intent        KeywordIntent?
  category      String?
  priority      KeywordPriority @default(MEDIUM)
  /// "Target Page" column from the import sheet (a hint, not an assignment)
  targetHint    String?
  role          KeywordRole?
  status        KeywordStatus   @default(UNASSIGNED)
  notes         String?
  source        String?
  isHome        Boolean         @default(false)
  serviceId     String?
  service       Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceAreaId String?
  serviceArea   ServiceArea?    @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  postId        String?
  post          Post?           @relation(fields: [postId], references: [id], onDelete: SetNull)
  pageId        String?
  page          Page?           @relation(fields: [pageId], references: [id], onDelete: SetNull)
  importId      String?
  import        KeywordImport?  @relation(fields: [importId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([serviceId])
  @@index([serviceAreaId])
  @@index([postId])
  @@index([pageId])
  @@index([category])
}

model KeywordImport {
  id           String    @id @default(cuid())
  filename     String
  rowCount     Int
  createdCount Int
  updatedCount Int
  skippedCount Int
  createdById  String?
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  keywords     Keyword[]
}
