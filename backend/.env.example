# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Local: `npm run db:local` starts Postgres on 5433 with these credentials.
DATABASE_URL=postgresql://plumbing:plumbing@localhost:5433/plumbing

API_PUBLIC_URL=http://localhost:4000
SITE_URL=http://localhost:3000
# Origins allowed to call the admin API with cookies (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must equal BACKEND_API_KEY in the website's .env.local
PUBLIC_API_KEY=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   (never change after launch)
APP_ENCRYPTION_KEY=

SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Instant website refresh after admin edits (secret must equal REVALIDATE_SECRET on the website)
SITE_REVALIDATE_URL=http://localhost:3000/api/revalidate
SITE_REVALIDATE_SECRET=

UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=8

# Email (password resets, lead notifications). Empty = emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Website <no-reply@example.com>
LEAD_NOTIFY_EMAILS=

# HMAC secret for call-tracking provider webhooks
CALL_TRACKING_WEBHOOK_SECRET=

LOG_LEVEL=info
# Behind a load balancer / reverse proxy: number of hops, e.g. 1
TRUST_PROXY=loopback

# Optional: first Owner account created by `npm run db:seed` (remove afterwards)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
