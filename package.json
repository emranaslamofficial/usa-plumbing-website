{
  "name": "usa-plumbing-website",
  "version": "1.0.0",
  "private": true,
  "description": "USA plumbing lead-generation website + CMS backend + admin panel, served by one Next.js server.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && npm run build:admin && next build",
    "build:admin": "npm --prefix admin run build -- --outDir ../public/admin --emptyOutDir",
    "vercel-build": "node tools/check-env.mjs && npm run db:generate && npm run db:deploy && npm run build:admin && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p backend",
    "db:local": "tsx backend/scripts/local-postgres.ts",
    "db:generate": "prisma generate --config backend/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config backend/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config backend/prisma.config.ts",
    "db:studio": "prisma studio --config backend/prisma.config.ts",
    "db:seed": "tsx backend/prisma/seed.ts",
    "admin:create": "tsx backend/scripts/create-admin.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "multer": "^2.5.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.33",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true,
    "@prisma/engines@7.10.1": true,
    "esbuild": true
  }
}
