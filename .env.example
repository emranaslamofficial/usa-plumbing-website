# Copy to .env.local for local development. Never commit .env.local.
# One server: website + admin panel (/admin) + API (/api/v1).
# On Vercel, set these in Project → Settings → Environment Variables (see docs/DEPLOY-VERCEL.md).

# ── Site ──
# Public address of the site, no trailing slash (canonical tags, sitemap, emails, cookies)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# ── Database ──
# Local: START WEBSITE.bat runs PostgreSQL with these credentials.
# Vercel + Neon: DATABASE_URL / DATABASE_URL_UNPOOLED are added automatically.
# Leave empty to run the website on built-in sample data (no admin panel).
DATABASE_URL=postgresql://plumbing:plumbing@localhost:5433/plumbing

# ── Secrets (generate your own) ──
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PUBLIC_API_KEY=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   (never change after launch)
APP_ENCRYPTION_KEY=
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
REVALIDATE_SECRET=

# Seconds pages are cached before re-reading the database (admin edits purge the cache instantly)
CONTENT_REVALIDATE_SECONDS=300

# ── Images ──
# Vercel Blob (added automatically when you connect a Blob store). Empty = save to backend/uploads.
BLOB_READ_WRITE_TOKEN=

# ── Email (password resets, new-lead notifications). Empty = emails are only logged. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Website <no-reply@example.com>
LEAD_NOTIFY_EMAILS=

# ── Optional ──
# HMAC secret for call-tracking provider webhooks (/api/v1/webhooks/calls/:provider)
CALL_TRACKING_WEBHOOK_SECRET=
LOG_LEVEL=info
# Spam protection placeholders (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Advanced: use a separately hosted backend instead of the built-in one
# BACKEND_API_URL=
# BACKEND_API_KEY=
