# ─────────────────────────────────────────────────────────────
# Public (exposed to the browser — never put secrets here)
# ─────────────────────────────────────────────────────────────
# Canonical production URL, no trailing slash. Used for canonical tags, sitemap, OG, schema.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ─────────────────────────────────────────────────────────────
# Server-only (read in route handlers / server components only)
# ─────────────────────────────────────────────────────────────
# Backend (backend/). When BACKEND_API_URL is empty the site runs on the mock data layer
# in src/lib/api/mock. When set, all content, leads and tracking go through the backend.
# BACKEND_API_KEY must equal PUBLIC_API_KEY in backend/.env.
BACKEND_API_URL=
BACKEND_API_KEY=

# Seconds to cache backend content (ISR). 0 = always fresh.
CONTENT_REVALIDATE_SECONDS=300

# Shared secret the backend sends to POST /api/revalidate after content edits.
# Must equal SITE_REVALIDATE_SECRET in backend/.env.
REVALIDATE_SECRET=

# Spam protection (Phase 2). If you enable Cloudflare Turnstile or reCAPTCHA,
# the site key is public, the secret key stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
